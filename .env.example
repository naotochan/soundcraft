# soundcraft — copy to .env and fill in what you need.
# You only need the settings for the backend(s) you actually use.
# The GUI writes these to Application Support instead; this file is for
# development and for headless/containerised servers.

# --- ComfyUI (recommended: any model ComfyUI supports) ----------------------
# Export your workflow with Workflow → Export (API) and put the JSON in the
# workflows folder shown by `soundcraft doctor`.
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW=
# COMFYUI_API_KEY=
# COMFYUI_TIMEOUT=900

# --- Local MusicGen (no key, works offline; needs the [local] extra) --------
# auto | cpu | cuda | mps
LOCAL_DEVICE=auto

# --- Replicate (hosted, pay per second) ------------------------------------
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Extra models to offer, comma or newline separated: owner/name[:version]
# REPLICATE_MODELS=sakemin/musicgen-stereo-chord

# --- Hugging Face (hosted, free tier) --------------------------------------
# https://huggingface.co/settings/tokens
HF_API_TOKEN=
# HF_INFERENCE_BASE=https://router.huggingface.co/hf-inference/models

# --- Lyria via Gemini (needs the [lyria] extra) -----------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# LYRIA_MODEL=lyria-3-clip-preview

# --- Optional prompt refinement --------------------------------------------
# Any OpenAI-compatible endpoint. Leave the model blank to skip refinement.
LM_STUDIO_URL=http://localhost:1234
LM_STUDIO_MODEL=liquid/lfm2-24b-a2b

# --- Server ----------------------------------------------------------------
# Required before binding anything other than 127.0.0.1. Clients then send
# `Authorization: Bearer <token>`.
# SOUNDCRAFT_API_TOKEN=
# Browser origins allowed to call the API cross-origin.
# SOUNDCRAFT_CORS_ORIGINS=https://example.com
# Override where generated audio is written.
# SOUNDCRAFT_OUTPUT_DIR=/data/output
